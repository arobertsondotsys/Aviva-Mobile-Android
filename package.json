{
  "name": "appium-aviva-mobile-tests",
  "version": "1.0.0",
  "description": "Pure Appium + WebdriverIO mobile web automation",
  "type": "commonjs",
  "main": "index.js",

  "scripts": {
    "test:wdio": "wdio run wdio.conf.js",
    "report:mocha:merge": "npx mochawesome-merge ./reports/mochawesome/*.json > ./reports/mochawesome/merged.json",
    "report:mocha:html": "npx marge ./reports/mochawesome/merged.json --reportDir ./reports/mochawesome --inline",
    "report:mocha": "npm run report:mocha:merge && npm run report:mocha:html"
  },

  "dependencies": {
    "appium": "^3.2.2",
    "webdriverio": "^8.30.0"
  },

  "devDependencies": {
    "@wdio/cli": "^8.30.0",
    "@wdio/local-runner": "^8.30.0",
    "@wdio/mocha-framework": "^8.30.0",
    "@wdio/spec-reporter": "^8.30.0",
    "@wdio/appium-service": "^8.30.0",
    "mocha": "^10.2.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0"
  }
}